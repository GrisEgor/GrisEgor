# Скопируйте в .env и заполните: cp .env.example .env
# Файл .env не попадает в git — в нём пароли.

# Домен сайта без https:// (DNS-запись A должна смотреть на IP сервера).
DOMAIN=dom-byta.ru
# Пароль базы данных: любая длинная случайная строка.
DB_PASSWORD=
# Этот адрес при первом входе становится администратором.
ADMIN_EMAIL=

# Почта для кодов входа и уведомлений (SMTP). Пример — Яндекс 360:
# SMTP_HOST=smtp.yandex.ru, SMTP_PORT=465, SMTP_USER=noreply@ваш-домен, SMTP_PASS=пароль приложения.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Дом быта <noreply@dom-byta.ru>

# Telegram: бот от @BotFather. Токен — для входа и уведомлений, имя — без @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Яндекс ID: приложение на oauth.yandex.ru, Redirect URI: https://ДОМЕН/api/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# VK ID: приложение на id.vk.com/about/business, доверенный Redirect URL: https://ДОМЕН/api/auth/vk/callback
VK_CLIENT_ID=
